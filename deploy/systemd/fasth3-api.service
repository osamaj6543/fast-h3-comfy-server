# /etc/systemd/system/fasth3-api.service
# Professional-grade API server unit. Run ComfyUI (comfyui.service) on the
# same instance; keep both bound to localhost and expose only this service
# behind an nginx/caddy TLS reverse proxy on the public interface.

[Unit]
Description=FastH3 Comfy Server (MiniMax H3 API)
After=network-online.target comfyui.service
Wants=network-online.target comfyui.service

[Service]
Type=simple
User=fasth3
Group=fasth3
WorkingDirectory=/opt/fasth3/server
Environment=FASTH3_DATA_DIR=/var/lib/fasth3
EnvironmentFile=/etc/fasth3/fasth3.env
# uv-managed virtual environment created with: uv venv /opt/fasth3/.venv
ExecStart=/opt/fasth3/.venv/bin/python -m uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 \
    --workers 1 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fasth3
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
