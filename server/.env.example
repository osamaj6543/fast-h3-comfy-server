# ---------------------------------------------------------------------------
# FastH3 Comfy Server configuration (all values optional, shown with defaults)
# ---------------------------------------------------------------------------

# ComfyUI backend (headless) base URL. Never expose this port publicly.
FASTH3_COMFY_URL=http://127.0.0.1:8188

# Comma-separated list of accepted API keys (X-API-Key header).
# Leave empty ONLY for local development (auth disabled).
FASTH3_API_KEYS=

# Secret used to sign result download URLs. Leave empty to derive from API keys.
FASTH3_URL_SIGNING_SECRET=

# Data directory for the SQLite job store, uploads, and generated videos.
FASTH3_DATA_DIR=./data

# Queue admission limits.
FASTH3_MAX_QUEUE_SIZE=64
FASTH3_MAX_ACTIVE_PER_KEY=4

# Lifetime (seconds) of signed result download URLs.
FASTH3_RESULT_URL_TTL_SECONDS=86400

# Worker poll interval when the queue is idle (seconds).
FASTH3_POLL_INTERVAL_SECONDS=1.0

# Log level: DEBUG, INFO, WARNING, ERROR.
FASTH3_LOG_LEVEL=INFO
